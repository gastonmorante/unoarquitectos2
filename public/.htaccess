# ==============================================================================
# UNO ARQUITECTOS - HTACCESS PRODUCTION CONFIGURATION (APACHE / HOSTGATOR)
# Optimized for React SPA, SEO 301 Redirects, HTTPS, Security & High Performance
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HOSTGATOR PHP HANDLER (PHP 8.2)
# ------------------------------------------------------------------------------
AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml

# ------------------------------------------------------------------------------
# 2. APACHE REWRITE ENGINE & HTTPS ENFORCEMENT
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 3. SEO 301 PERMANENT REDIRECTS (MIGRATION FROM OLD WORDPRESS URLS)
  # Preserves Google indexation, PageRank and link equity
  # ----------------------------------------------------------------------------

  # Old WordPress Section Pages -> New React Section Anchors
  RewriteRule ^contacto/?$ /#contacto [R=301,L,NE]
  RewriteRule ^nosotros/?$ /#filosofia [R=301,L,NE]
  RewriteRule ^filosofia/?$ /#filosofia [R=301,L,NE]
  RewriteRule ^esencia/?$ /#filosofia [R=301,L,NE]
  RewriteRule ^proyectos/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^portafolio/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^portfolio/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^servicios/?$ /#servicios [R=301,L,NE]
  RewriteRule ^estudio/?$ /#servicios [R=301,L,NE]
  RewriteRule ^faqs/?$ /#faqs [R=301,L,NE]
  RewriteRule ^preguntas-frecuentes/?$ /#faqs [R=301,L,NE]

  # Legal & Privacy Policy URLs
  RewriteRule ^aviso-de-privacidad/?$ /?legal=privacy [R=301,L]
  RewriteRule ^politica-de-privacidad/?$ /?legal=privacy [R=301,L]
  RewriteRule ^terminos-y-condiciones/?$ /?legal=terms [R=301,L]

  # Block / Redirect old WordPress endpoints to clean home
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^wp-admin.*$ / [R=301,L]
  RewriteRule ^xmlrpc\.php$ - [F,L]
  RewriteRule ^feed/?$ / [R=301,L]

  # ----------------------------------------------------------------------------
  # 4. SINGLE PAGE APPLICATION (SPA) FALLBACK ROUTING
  # If request is not an existing file or directory, route to index.html
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. GZIP / DEFLATE COMPRESSION FOR CORE WEB VITALS SPEED
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ------------------------------------------------------------------------------
# 6. BROWSER CACHING HEADERS (LEVERAGE CACHING)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifest (no cache or short cache for quick updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # CSS, JavaScript (Vite uses content-hashed filenames for immutable caching)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 7. SECURITY HEADERS & FILE PROTECTION
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Block access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Prevent directory browsing
Options -Indexes
