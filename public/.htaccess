# ==============================================================================
# UNO ARQUITECTOS - HTACCESS PRODUCTION CONFIGURATION (APACHE / HOSTGATOR)
# Multi-Page Architecture, Subdirectory i18n (/en/, /fr/, /it/), Strict 301 & 404
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HOSTGATOR PHP HANDLER (PHP 8.2) & CUSTOM REAL 404 ERROR DOCUMENT
# ------------------------------------------------------------------------------
AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 2. APACHE REWRITE ENGINE & HTTPS ENFORCEMENT
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical Host Enforcement: Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.unoarquitectos\.com$ [NC]
  RewriteRule ^(.*)$ https://unoarquitectos.com/$1 [L,R=301]

  # Canonical Root: Redirect direct /index.html requests to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://unoarquitectos.com/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. SEO 301 PERMANENT REDIRECTS (LEGACY MIGRATION & AUDIT DISCOVERY FIXES)
  # ----------------------------------------------------------------------------

  # Exact Historical URLs from Search Console Audit Table (Audit Hallazgo #1)
  RewriteRule ^en/architects-in-playa-del-carmen/?$ /en/arquitectos-en-quintana-roo [R=301,L,NE]
  RewriteRule ^en/architects-in-quintana-roo/?$ /en/arquitectos-en-quintana-roo [R=301,L,NE]
  RewriteRule ^en/architects-in-tulum/?$ /en/arquitectos-en-tulum [R=301,L,NE]
  RewriteRule ^blogs-sobre-arquitectura/?$ /blog [R=301,L,NE]
  RewriteRule ^2023/11/27/redescubriendo-la-magia-de-la-arquitectura-maya/?$ /blog/acabado-chukum-arquitectura-bioclimatica-tropical [R=301,L,NE]
  RewriteRule ^202[0-9]/[0-9]{2}/[0-9]{2}/.*$ /blog [R=301,L,NE]
  RewriteRule ^202[0-9]/.*$ /blog [R=301,L,NE]

  # Query Parameter Lang Migration (?lang=en -> /en/)
  RewriteCond %{QUERY_STRING} ^lang=en$ [NC]
  RewriteRule ^$ /en/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^lang=it$ [NC]
  RewriteRule ^$ /it/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^lang=fr$ [NC]
  RewriteRule ^$ /fr/? [R=301,L]

  # A. Sección Filosofía / Quiénes Somos / Identidad Local
  RewriteRule ^quienes-somos.*$ /#nosotros [R=301,L,NE]
  RewriteRule ^a-que-nos-dedicamos.*$ /#nosotros [R=301,L,NE]
  RewriteRule ^nosotros/?$ /#nosotros [R=301,L,NE]
  RewriteRule ^filosofia/?$ /#filosofia [R=301,L,NE]
  RewriteRule ^esencia/?$ /#filosofia [R=301,L,NE]
  RewriteRule ^about/?$ /#filosofia [R=301,L,NE]

  # B. Sección Servicios / Disciplinas / Construcción Llave en Mano
  RewriteRule ^servicios/?$ /#servicios [R=301,L,NE]
  RewriteRule ^services/?$ /#servicios [R=301,L,NE]
  RewriteRule ^estudio/?$ /#servicios [R=301,L,NE]
  RewriteRule ^disciplinas/?$ /#servicios [R=301,L,NE]
  RewriteRule ^obra-llave-en-mano.*$ /arquitectos-en-quintana-roo [R=301,L,NE]
  RewriteRule ^obra-negra.*$ /#servicios [R=301,L,NE]
  RewriteRule ^obra-gris.*$ /#servicios [R=301,L,NE]
  RewriteRule ^obra-blanca.*$ /#servicios [R=301,L,NE]
  RewriteRule ^empresa-de-construccion.*$ /arquitectos-en-quintana-roo [R=301,L,NE]

  # C. Sección Portafolio / Proyectos Individuales
  RewriteRule ^proyectos/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^portafolio/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^portfolio/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^coleccion/?$ /#proyectos [R=301,L,NE]
  RewriteRule ^7-cielos.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^residencia-7-cielos.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^alux.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^villas-alux.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^nikkori.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^oceana.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^villa-vidorra.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^villa-chukum.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^casa-coral.*$ /#proyectos [R=301,L,NE]
  RewriteRule ^casa-tzalam.*$ /#proyectos [R=301,L,NE]

  # D. Sección Contacto & FAQs
  RewriteRule ^contacto/?$ /#contacto [R=301,L,NE]
  RewriteRule ^contact/?$ /#contacto [R=301,L,NE]
  RewriteRule ^dialogo/?$ /#contacto [R=301,L,NE]
  RewriteRule ^ubicaciones/?$ /#contacto [R=301,L,NE]
  RewriteRule ^faqs/?$ /#faqs [R=301,L,NE]
  RewriteRule ^preguntas-frecuentes/?$ /#faqs [R=301,L,NE]

  # E. Términos & Privacidad Legal
  RewriteRule ^aviso-de-privacidad/?$ /?legal=privacy [R=301,L]
  RewriteRule ^politica-de-privacidad/?$ /?legal=privacy [R=301,L]
  RewriteRule ^terminos-y-condiciones/?$ /?legal=terms [R=301,L]

  # F. Limpieza de Endpoints y Taxonomías de WordPress
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^wp-admin.*$ / [R=301,L]
  RewriteRule ^category/.*$ /blog [R=301,L]
  RewriteRule ^tag/.*$ /blog [R=301,L]
  RewriteRule ^author/.*$ / [R=301,L]
  RewriteRule ^feed/?$ / [R=301,L]
  RewriteRule ^xmlrpc\.php$ - [F,L]

  # G. Endpoints API en HostGator
  RewriteRule ^api/reviews/?$ api/reviews.php [L,QSA]
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
  RewriteRule ^api/leads/?$ api/contact.php [L,QSA]

  # ----------------------------------------------------------------------------
  # 4. REAL STATIC FILES & PHYSICAL DIRECTORIES
  # ----------------------------------------------------------------------------
  # If requested file or directory exists physically, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------------
  # 5. MULTI-PAGE SUBDIRECTORIES & LOCALIZED STATIC HTML ROUTING
  # ----------------------------------------------------------------------------
  # Explicit localized entrypoint routing
  RewriteRule ^(en|fr|it)/?$ $1/index.html [L,QSA]
  RewriteRule ^(en|fr|it)/(arquitectos-en-tulum|arquitectos-en-quintana-roo|blog)/?$ $1/$2/index.html [L,QSA]
  RewriteRule ^(en|fr|it)/blog/([a-zA-Z0-9_-]+)/?$ $1/blog/index.html [L,QSA]

  # Spanish subpages routing
  RewriteRule ^(arquitectos-en-tulum|arquitectos-en-quintana-roo|blog)/?$ $1/index.html [L,QSA]
  RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog/index.html [L,QSA]

  # Client Portal & Admin SPA routes
  RewriteRule ^(clientes|portal|admin)/?$ index.html [L,QSA]

  # Root Entrypoint
  RewriteRule ^$ index.html [L,QSA]

  # Any other unmapped route returns REAL HTTP 404 with custom 404.html
  RewriteRule ^.+$ /404.html [R=404,L]
</IfModule>

# ------------------------------------------------------------------------------
# 6. GZIP / DEFLATE COMPRESSION FOR CORE WEB VITALS SPEED
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon text/markdown
</IfModule>

# LLMs.txt MIME Type
<Files "llms.txt">
  ForceType text/markdown
  Header set Content-Type "text/markdown; charset=utf-8"
</Files>

# ------------------------------------------------------------------------------
# 7. BROWSER CACHING HEADERS (LEVERAGE CACHING)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 8. ADVANCED SECURITY HEADERS & DEFENSIVE HARDENING
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://services.leadconnectorhq.com https://*.leadconnectorhq.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://generativelanguage.googleapis.com; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self';"
</IfModule>

# Block access to hidden files and sensitive developer files
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|ts))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Explicitly ensure images, assets and media are always accessible
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|json|xml|txt|woff|woff2|ttf|eot|mp4|webm)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Allow from all
  </IfModule>
</FilesMatch>

Options -Indexes
